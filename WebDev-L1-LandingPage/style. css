* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #070707;
    color: #ffffff;
    line-height: 1.5;
}

button,
input {
    font-family: inherit;
}

a {
    text-decoration: none;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 75px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 6%;
    background: rgba(7, 7, 7, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 1000;
}

.logo {
    color: #e50914;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 2px;
}

.navbar nav {
    display: flex;
    align-items: center;
    gap: 30px;
}

.navbar nav a {
    position: relative;
    color: #dddddd;
    font-size: 14px;
    font-weight: 600;
    transition: 0.3s;
}

.navbar nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -7px;
    width: 0;
    height: 2px;
    background: #e50914;
    transition: 0.3s;
}

.navbar nav a:hover {
    color: #ffffff;
}

.navbar nav a:hover::after {
    width: 100%;
}

.signin-btn {
    background: #e50914;
    color: #ffffff;
    border: none;
    padding: 10px 21px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.3s;
}

.signin-btn:hover {
    background: #b20710;
    transform: translateY(-2px);
}

.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 8% 80px;
    position: relative;
    background:
        linear-gradient(
            90deg,
            #070707 0%,
            rgba(7, 7, 7, 0.92) 35%,
            rgba(7, 7, 7, 0.45) 70%,
            #070707 100%
        ),
        linear-gradient(
            0deg,
            #070707 0%,
            transparent 35%
        ),
        url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=80");
    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 650px;
    animation: heroFade 1s ease;
}

@keyframes heroFade {
    from {
        opacity: 0;
        transform: translateY(25px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.small-title {
    color: #e50914;
    font-size: 14px;
    font-weight: bold;
    letter-spacing: 4px;
    margin-bottom: 18px;
}

.hero h1 {
    font-size: clamp(48px, 7vw, 82px);
    line-height: 1.02;
    margin-bottom: 25px;
}

.hero-description {
    color: #d2d2d2;
    font-size: 18px;
    line-height: 1.7;
    max-width: 580px;
    margin-bottom: 32px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
}

.watch-btn,
.more-btn {
    border: none;
    padding: 14px 28px;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.watch-btn {
    background: #e50914;
    color: #ffffff;
}

.watch-btn:hover {
    background: #b20710;
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(229, 9, 20, 0.25);
}

.more-btn {
    background: rgba(255, 255, 255, 0.16);
    color: #ffffff;
    backdrop-filter: blur(5px);
}

.more-btn:hover {
    background: rgba(255, 255, 255, 0.28);
    transform: translateY(-3px);
}

.trending,
.features,
.faq {
    padding: 95px 6%;
}

.section-title {
    margin-bottom: 42px;
}

.section-title h2 {
    font-size: 36px;
    margin-bottom: 10px;
}

.section-title p {
    color: #999999;
    font-size: 15px;
}

.movie-container {
    display: grid;
    grid-template-columns: repeat(5, minmax(150px, 1fr));
    gap: 20px;
}

.movie-card {
    position: relative;
    background: #151515;
    border-radius: 7px;
    overflow: hidden;
    padding-bottom: 18px;
    transition: 0.35s;
}

.movie-card:hover {
    transform: translateY(-8px) scale(1.025);
    box-shadow: 0 18px 35px rgba(0, 0, 0, 0.5);
}

.movie-image {
    height: 300px;
    background-size: cover;
    background-position: center;
    transition: 0.4s;
}

.movie-card:hover .movie-image {
    transform: scale(1.05);
}

.movie-one {
    background: linear-gradient(135deg, #280000, #8d0000);
}

.movie-two {
    background: linear-gradient(135deg, #101a3d, #714b1c);
}

.movie-three {
    background: linear-gradient(135deg, #080808, #4b174d);
}

.movie-four {
    background: linear-gradient(135deg, #171717, #783300);
}

.movie-five {
    background: linear-gradient(135deg, #071c2d, #5c1830);
}

.number {
    position: absolute;
    top: 10px;
    left: 10px;
    font-size: 42px;
    font-weight: 900;
    color: #ffffff;
    text-shadow: 2px 2px 10px #000000;
    z-index: 2;
}

.movie-card h3 {
    padding: 16px 15px 5px;
}

.movie-card p {
    padding: 0 15px;
    color: #999999;
    font-size: 13px;
}

.features {
    background: #101010;
}

.feature-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.feature-card {
    background: #181818;
    padding: 38px 30px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    text-align: center;
    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-8px);
    border-color: rgba(229, 9, 20, 0.5);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
}

.feature-icon {
    font-size: 45px;
    margin-bottom: 20px;
}

.feature-card h3 {
    font-size: 21px;
    margin-bottom: 14px;
}

.feature-card p {
    color: #aaaaaa;
    line-height: 1.7;
}

.cta {
    text-align: center;
    padding: 110px 20px;
    background:
        linear-gradient(
            rgba(0, 0, 0, 0.82),
            rgba(0, 0, 0, 0.94)
        ),
        url("https://images.unsplash.com/photo-1485846234645-a62644f84728?auto=format&fit=crop&w=1800&q=80");
    background-size: cover;
    background-position: center;
}

.cta h2 {
    font-size: clamp(30px, 5vw, 45px);
    margin-bottom: 15px;
}

.cta p {
    color: #cccccc;
    margin-bottom: 30px;
}

.faq-container {
    max-width: 850px;
    margin: auto;
}

.faq-item {
    margin-bottom: 10px;
}

.faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    background: #242424;
    color: #ffffff;
    border: none;
    font-size: 17px;
    text-align: left;
    cursor: pointer;
    transition: 0.3s;
}

.faq-question:hover {
    background: #303030;
}

.faq-question span {
    font-size: 25px;
}

.faq-answer {
    display: none;
    padding: 20px;
    background: #181818;
    color: #bbbbbb;
    line-height: 1.6;
}

.faq-item.active .faq-answer {
    display: block;
}

footer {
    padding: 50px 6%;
    background: #050505;
    text-align: center;
    border-top: 1px solid #1b1b1b;
}

.footer-logo {
    color: #e50914;
    font-size: 25px;
    font-weight: 900;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

footer p {
    color: #777777;
    margin-bottom: 20px;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 25px;
}

.footer-links a {
    color: #aaaaaa;
    transition: 0.3s;
}

.footer-links a:hover {
    color: #e50914;
}

@media (max-width: 900px) {

    .movie-container {
        grid-template-columns: repeat(3, 1fr);
    }

    .feature-container {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {

    .navbar {
        height: 65px;
        padding: 0 18px;
    }

    .navbar nav {
        display: none;
    }

    .logo {
        font-size: 20px;
    }

    .signin-btn {
        padding: 9px 16px;
    }

    .hero {
        padding: 120px 25px 70px;
        min-height: 90vh;
        background-position: 65% center;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-description {
        font-size: 16px;
    }

    .hero-buttons {
        flex-direction: column;
        align-items: flex-start;
    }

    .watch-btn,
    .more-btn {
        width: 100%;
    }

    .trending,
    .features,
    .faq {
        padding: 70px 20px;
    }

    .section-title h2 {
        font-size: 29px;
    }

    .movie-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .movie-image {
        height: 230px;
    }

    .number {
        font-size: 32px;
    }

    .movie-card h3 {
        font-size: 15px;
    }

    .movie-card p {
        font-size: 12px;
    }

    .feature-container {
        grid-template-columns: 1fr;
    }

    .feature-card {
        padding: 30px 20px;
    }

    .cta {
        padding: 80px 20px;
    }

    .cta h2 {
        font-size: 30px;
    }

    .footer-links {
        flex-wrap: wrap;
    }
}

@media (max-width: 400px) {

    .logo {
        font-size: 17px;
    }

    .signin-btn {
        padding: 8px 12px;
        font-size: 12px;
    }

    .hero h1 {
        font-size: 38px;
    }

    .movie-container {
        grid-template-columns: 1fr;
    }

    .movie-image {
        height: 280px;
    }
}

.signin-page {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px;
    background:
        linear-gradient(
            rgba(0, 0, 0, 0.85),
            rgba(0, 0, 0, 0.95)
        ),
        url("https://images.unsplash.com/photo-1489599849927-2ee91cede3ba?auto=format&fit=crop&w=1800&q=80");
    background-size: cover;
    background-position: center;
}

.signin-box {
    width: 100%;
    max-width: 430px;
    padding: 45px;
    background: rgba(0, 0, 0, 0.82);
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
}

.signin-logo {
    color: #e50914;
    font-size: 27px;
    font-weight: 900;
    letter-spacing: 2px;
    text-align: center;
    margin-bottom: 35px;
}

.signin-box h1 {
    font-size: 32px;
    margin-bottom: 25px;
}

.signin-box input {
    width: 100%;
    padding: 16px;
    margin-bottom: 15px;
    background: #333333;
    color: #ffffff;
    border: 1px solid transparent;
    border-radius: 4px;
    outline: none;
    font-size: 15px;
}

.signin-box input:focus {
    border-color: #e50914;
}

.signin-box form button {
    width: 100%;
    padding: 15px;
    margin-top: 10px;
    background: #e50914;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
}

.signin-box form button:hover {
    background: #b20710;
}

.signup-text {
    color: #999999;
    margin-top: 25px;
    font-size: 14px;
}

.signup-text span {
    color: #ffffff;
    cursor: pointer;
    font-weight: bold;
}

.signup-text span:hover {
    text-decoration: underline;
}

.back-btn {
    margin-top: 25px;
    background: transparent;
    color: #aaaaaa;
    border: none;
    cursor: pointer;
    font-size: 14px;
}

.back-btn:hover {
    color: #ffffff;
}

@media (max-width: 500px) {

    .signin-box {
        padding: 30px 22px;
    }
}
